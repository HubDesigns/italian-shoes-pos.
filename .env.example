# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/italian_shoes?schema=public"

# Direct PostgreSQL connection for Prisma migrations (disable pooling in Neon)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/italian_shoes?sslmode=require"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Authentication (generate long random values; never commit .env)
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
OWNER_SETUP_SECRET="REPLACE_WITH_A_SEPARATE_ONE_TIME_SETUP_SECRET"
